# ===========================================================================
# ProductLift configuration. Copy to `.env` (gitignored).
#   Copy-Item .env.example .env   (PowerShell)
# Most settings live in config/params.yaml; this file is for paths & secrets.
# ===========================================================================

# Where the Olist dataset lives once downloaded (see data/README.md).
DATA_DIR=./data

# Kaggle credentials, ONLY if you use scripts/download_data.py --kaggle.
# Get them from https://www.kaggle.com/settings -> "Create New API Token".
KAGGLE_USERNAME=
KAGGLE_KEY=

# Serving
APP_HOST=0.0.0.0
APP_PORT=8000
MODEL_PATH=./models/current.joblib

LOG_LEVEL=INFO
RANDOM_SEED=42
