{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "TEMPLATE. Copy to .claude/settings.json to activate the shared agent guardrails. settings.local.json (gitignored) holds your personal overrides.",
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(python -m scripts.build_features)",
      "Bash(python -m scripts.train)",
      "Bash(python -m scripts.evaluate)",
      "Bash(make:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Read(.env)"
    ]
  },
  "env": {
    "PYTHONUNBUFFERED": "1"
  }
}
